---
import { PLACEHOLDER, KINDS, type Work } from '../data/works.ts';
import { withBase } from '../lib/url';

interface Props { work: Work; showClient?: boolean }
const { work } = Astro.props;
const kindLabel = KINDS.find((k) => k.id === work.kind)?.label ?? '';
const hasVideo = !!work.youtubeId && work.youtubeId !== PLACEHOLDER;
const client = work.client && !work.hideClient ? work.client : '';
---
<figure class={`vcard vcard--${work.orientation}`} data-kind={work.kind}>
  {hasVideo ? (
    <button class="vcard__media" type="button" data-yt={work.youtubeId} aria-label={`播放：${work.title}`}>
      <img src={`https://i.ytimg.com/vi/${work.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
      <span class="vcard__play" aria-hidden="true">▶</span>
    </button>
  ) : work.image ? (
    <div class="vcard__media">
      <img src={withBase(work.image)} alt={work.title} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="vcard__media vcard__media--empty" data-testid="work-placeholder">
      <span class="mono">COCO</span>
      <span>作品準備中</span>
    </div>
  )}
  <figcaption>
    <span class="vcard__kind mono">{kindLabel}</span>
    <span class="vcard__title">{work.title}</span>
    {client && <span class="vcard__client">{client}</span>}
  </figcaption>
</figure>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-yt]');
    if (!btn) return;
    const id = btn.dataset.yt!;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1`;
    iframe.title = btn.getAttribute('aria-label') || '影片';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    btn.replaceWith(iframe);
  });
</script>

<style>
  .vcard { margin: 0; min-width: 0; }
  .vcard__media, .vcard :global(iframe) {
    position: relative; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0;
    border-radius: var(--radius); overflow: hidden; background: var(--sand-2); display: block;
  }
  .vcard--portrait .vcard__media, .vcard--portrait :global(iframe) { aspect-ratio: 9 / 16; }
  button.vcard__media { cursor: pointer; }
  .vcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .vcard__play {
    position: absolute; inset: 0; margin: auto; width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(46, 36, 29, .75); color: var(--cream-2); font-size: 18px;
  }
  .vcard__media--empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
    background: repeating-linear-gradient(135deg, var(--sand) 0 14px, #c6b298 14px 28px);
    color: var(--espresso); font-size: 13px;
  }
  .vcard__media--empty .mono { letter-spacing: .3em; font-weight: 600; }
  figcaption { display: flex; flex-direction: column; padding-top: 8px; line-height: 1.5; }
  .vcard__kind { font-size: 11px; letter-spacing: .2em; color: var(--copper-text); }
  .vcard__title { font-size: 14px; font-weight: 500; }
  .vcard__client { font-size: 12px; color: var(--ink-soft); }
  :global(.section--dark) .vcard__kind { color: var(--copper-light); }
  :global(.section--dark) .vcard__client { color: #CDBFAE; }
</style>
