---
import { PROCESS } from '../data/process.ts';
---
<ol class="proc">
  {PROCESS.map((s, i) => (
    <li>
      <span class="proc__no mono">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .proc { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 0; }
  @media (min-width: 768px) { .proc { grid-template-columns: repeat(3, 1fr); gap: 0 28px; } }
  .proc li { display: flex; gap: 14px; padding: 18px 0; border-top: 1px solid var(--sand-2); }
  .proc__no { color: var(--copper-text); font-size: 14px; padding-top: 3px; }
  .proc h3 { font-size: 17px; margin-bottom: 4px; }
  .proc p { margin: 0; font-size: 14px; color: var(--ink-soft); }
</style>
