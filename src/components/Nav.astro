---
import { SITE } from '../data/site';
import { withBase } from '../lib/url';
const path = Astro.url.pathname;
---
<header class="nav">
  <div class="wrap nav__in">
    <a class="nav__logo mono" href={withBase('/')} aria-label={`${SITE.name} 首頁`}>{SITE.short}<span>CREATIVE</span></a>
    <nav aria-label="主選單">
      <ul class="nav__list">
        {SITE.nav.map((item) => {
          const href = withBase(item.href);
          return <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{item.label}</a></li>;
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: rgba(46, 36, 29, .94);
    backdrop-filter: blur(8px);
    color: var(--cream-2);
  }
  .nav__in { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); gap: 16px; }
  .nav__logo { font-size: 17px; font-weight: 600; letter-spacing: .28em; text-decoration: none; white-space: nowrap; }
  .nav__logo span { display: none; margin-left: .6em; font-weight: 400; color: var(--copper-light); }
  .nav__list { display: flex; gap: clamp(14px, 3vw, 36px); list-style: none; margin: 0; padding: 0; font-size: 14px; letter-spacing: .12em; }
  .nav__list a { text-decoration: none; opacity: .85; padding: 6px 0; border-bottom: 1px solid transparent; }
  .nav__list a:hover, .nav__list a[aria-current='page'] { opacity: 1; border-bottom-color: var(--copper-light); }
  @media (min-width: 640px) { .nav__logo span { display: inline; } }
</style>
