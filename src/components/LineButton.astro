---
import { SITE } from '../data/site';
---
<div class="line-fab" data-testid="line-button">
  <span class="line-fab__hint">諮詢前請先參考各服務起價</span>
  <a class="line-fab__btn" href={SITE.line.url} target="_blank" rel="noopener" aria-label="用 LINE 諮詢（另開視窗）">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.3 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.6 1.1-.5 6-3.5 8.2-6 1.5-1.6 2.2-3.3 2.2-5C22.5 6.6 17.5 3 12 3Z"/></svg>
    LINE 諮詢
  </a>
</div>

<style>
  .line-fab {
    position: fixed; z-index: 50;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: flex-end; gap: 6px;
    max-width: calc(100vw - 32px);
  }
  .line-fab__hint {
    font-size: 11px; letter-spacing: .04em;
    background: rgba(46, 36, 29, .88); color: var(--cream-2);
    padding: 3px 10px; border-radius: 999px;
  }
  .line-fab__btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: #06C755; color: #fff; text-decoration: none; font-weight: 700;
    padding: 12px 18px; border-radius: 999px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .25);
  }
  .line-fab__btn:hover { background: #05a547; }
</style>
