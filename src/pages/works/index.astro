---
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import { WORKS, KINDS } from '../../data/works.ts';

const filters = [{ id: 'all', label: '全部' }, ...KINDS];
const emptyKinds = KINDS.filter((k) => !WORKS.some((w) => w.kind === k.id));
---
<Base title="作品集" description="COCO CREATIVE 作品集：長片、短影音、AI 影片與網站。">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Works</p>
      <h1 class="h-section">作品集</h1>
      <p class="lead">長片、短影音、AI 影片與網站。影片點縮圖就能播放，網站點了會開新分頁。</p>

      <div class="works">
        <div class="filters" role="radiogroup" aria-label="作品分類">
          {filters.map((f, i) => (
            <label class="filter">
              <input type="radio" name="kind" id={`f-${f.id}`} value={f.id} checked={i === 0} />
              <span>{f.label}</span>
            </label>
          ))}
        </div>

        <div class="grid">
          {WORKS.map((w) => <div class={`grid__item grid__item--${w.orientation}`} data-kind={w.kind}><VideoCard work={w} /></div>)}
        </div>

        {emptyKinds.map((k) => (
          <p class="coming" data-empty-for={k.id}>{k.label}作品即將更新，歡迎先用 LINE 詢問。</p>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 24px; }
  .filter input { position: absolute; opacity: 0; pointer-events: none; }
  .filter span {
    display: inline-block; padding: 7px 16px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--espresso); font-size: 14px;
  }
  .filter input:checked + span { background: var(--espresso); color: var(--cream-2); }
  .filter input:focus-visible + span { outline: 2px solid var(--copper); outline-offset: 2px; }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 14px; align-items: start; }
  .grid__item--landscape { grid-column: span 2; }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .coming { display: none; padding: 28px; text-align: center; border: 1px dashed var(--sand-2); border-radius: var(--radius); }

  .works:has(#f-long:checked) .grid__item:not([data-kind='long']),
  .works:has(#f-short:checked) .grid__item:not([data-kind='short']),
  .works:has(#f-ai:checked) .grid__item:not([data-kind='ai']),
  .works:has(#f-web:checked) .grid__item:not([data-kind='web']) { display: none; }

  .works:has(#f-long:checked) [data-empty-for='long'],
  .works:has(#f-short:checked) [data-empty-for='short'],
  .works:has(#f-ai:checked) [data-empty-for='ai'],
  .works:has(#f-web:checked) [data-empty-for='web'] { display: block; }
</style>
